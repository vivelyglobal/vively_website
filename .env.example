# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vively_campaigns?retryWrites=true&w=majority

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-site.netlify.app/.netlify/functions/auth-google-callback

# OAuth - Instagram (requires Facebook Business Account)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_CALLBACK_URL=https://your-site.netlify.app/.netlify/functions/auth-instagram-callback

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this

# Admin
ADMIN_EMAIL=admin@vively.com
ADMIN_PASSWORD_HASH=bcrypted_hash_here

# Site
SITE_URL=https://your-site.netlify.app
