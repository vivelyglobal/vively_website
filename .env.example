# ============================================================
# Vively Global — Environment Variables (TEMPLATE)
# ============================================================
# Copy to `.env.local` for local dev, or set in Netlify Dashboard
# for production. NEVER commit real secrets.
# ============================================================

# --------- MongoDB ---------
# Local:   mongodb://localhost:27017/vively_campaigns
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vively_campaigns?retryWrites=true&w=majority
MONGODB_URI=

# --------- Node runtime ---------
# Set to "production" on Netlify. In dev, leave unset OR set to "development".
# When production, dev-only responses (like verification codes in JSON) are suppressed.
NODE_ENV=development

# --------- JWT ---------
# Must be at least 16 characters. Generate: openssl rand -base64 48
JWT_SECRET=

# --------- Google OAuth ---------
# Public client ID from Google Cloud Console -> APIs & Services -> Credentials.
# Web application type. Add http://localhost:8888 + your Netlify domain to Authorized JS origins.
GOOGLE_CLIENT_ID=

# --------- Email (Brevo transactional) ---------
# Get key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Vively

# --------- Admin bootstrap ---------
# Used by seed.js to create the first admin user in local dev.
ADMIN_EMAIL=admin@vively.com

# --------- Site URLs ---------
# Used in email templates and OAuth callbacks.
SITE_URL=http://localhost:8888

# --------- Seed endpoint (production only) ---------
# If set AND NODE_ENV=production, callers must pass matching X-Seed-Token header
# to hit /.netlify/functions/seed. Leave blank in prod to disable seed entirely.
SEED_TOKEN=
