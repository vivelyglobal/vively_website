node_modules/ 

# Local Netlify folder
.netlify

# Env / secrets — NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key

# Google OAuth client JSON (never commit)
client_secret_*.json
credentials.json

# User uploads written by the dev-only local-disk fallback. business-docs/
# holds brand KYC documents (사업자등록증) — these must never be committed.
assets/uploads/*
!assets/uploads/.gitkeep
assets/uploads/business-docs/

# OS / editor
.DS_Store
.vscode/
.idea/
.dev.vars
