# Cloudflare Pages cache headers.
# Media/CSS/JS get a long edge+browser cache since this is the biggest win
# for load time (work.html alone ships several MB of video).
# Caveat: if you ever REPLACE a file at the same path (e.g. re-upload
# juno-1.mp4 with new content), cached visitors won't see the update for up
# to a year. Rename the file (or add a ?v= query the HTML already uses for
# some CSS/JS) when swapping content in place, or purge cache in the
# Cloudflare dashboard after a swap.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate
